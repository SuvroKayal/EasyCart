# ==============================================================================
# EasyCart Environment Configuration Template
# Copy this file to .env and populate with production values before deployment.
# ==============================================================================

# Application Environment ('development', 'production', or 'testing')
FLASK_ENV=development
FLASK_DEBUG=1

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Security: Mandatory high-entropy session secret (min 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production

# Primary Database Connection String
# For Supabase / PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# If left blank, the application automatically falls back to local SQLite (Backend/easycart.db)
DATABASE_URL=

# Authorized Administrator Email Allowlist (comma-separated, case-insensitive)
ADMIN_EMAILS=suvrokayal2005@gmail.com,shraddha66singh66@gmail.com

# Google OAuth 2.0 Client ID (Web Application from Google Cloud Console)
# Ensure your Google Cloud Console Web Client includes:
#   Authorized JavaScript origins: http://localhost:5000, https://easycart-vzl7.onrender.com
#   Authorized redirect URIs:      http://localhost:5000, https://easycart-vzl7.onrender.com
GOOGLE_CLIENT_ID=334860227356-tmgcjjar1p1bf8g14nllr2qolldu60gr.apps.googleusercontent.com

# Delivery Fee & Threshold Configuration (in INR)
STANDARD_DELIVERY_FEE=40.0
FREE_DELIVERY_THRESHOLD=999.0

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=True
